// Auth Component
const AuthComponent = ({ user }: { user: User | null | undefined }) => {
  const [open, setOpen] = useState(false);

  return (
    <Box>
      <IconButton color="inherit" onClick={() => setOpen(true)}>
        {user ? <LogoutIcon /> : <LoginIcon />}
      </IconButton>
      <Dialog open={open} onClose={() => setOpen(false)}>
        <DialogTitle>{user ? 'Sign Out' : 'Sign In'}</DialogTitle>
        <DialogContent>
          <Typography>
            {user ? 'Are you sure you want to sign out?' : 'Please sign in to sync your data'}
          </Typography>
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setOpen(false)}>Cancel</Button>
          <Button variant="contained">{user ? 'Sign Out' : 'Sign In'}</Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

// Navigation Component
const NavigationComponent = () => {
  const navigate = useNavigate();
  const location = useLocation();
  const [value, setValue] = useState(() => {
    switch (location.pathname) {
      case '/': return 0;
      case '/reporter': return 1;
      case '/analyzer': return 2;
      case '/timers': return 3;
      default: return 0;
    }
  });

  const handleChange = (event: React.SyntheticEvent, newValue: number) => {
    setValue(newValue);
    switch (newValue) {
      case 0: navigate('/'); break;
      case 1: navigate('/reporter'); break;
      case 2: navigate('/analyzer'); break;
      case 3: navigate('/timers'); break;
    }
  };

  return (
    <Paper sx={{ position: 'fixed', bottom: 0, left: 0, right: 0 }} elevation={3}>
      <BottomNavigation value={value} onChange={handleChange}>
        <BottomNavigationAction label="Tracker" icon={<TrackerIcon />} />
        <BottomNavigationAction label="Reporter" icon={<ReporterIcon />} />
        <BottomNavigationAction label="Analyzer" icon={<AnalyzerIcon />} />
        <BottomNavigationAction label="Timers" icon={<TimersIcon />} />
      </BottomNavigation>
    </Paper>
  );
};

// Main App Component
const App = () => {
  const [user, loading, error] = useAuthState(auth);

  return (
    <ThemeProvider theme={theme}>
      <CssBaseline />
      <Router>
        <Box sx={{ pb: 7 }}>
          <AppBar position="static">
            <Toolbar>
              <Typography variant="h6" component="div" sx={{ flexGrow: 1 }}>
                Putting in the Work
              </Typography>
              <AuthComponent user={user} />
            </Toolbar>
          </AppBar>
          
          <Routes>
            <Route path="/" element={<TrackerPage />} />
            <Route path="/reporter" element={<ReporterPage />} />
            <Route path="/analyzer" element={<AnalyzerPage />} />
            <Route path="/timers" element={<TimersPage />} />
          </Routes>
          
          <NavigationComponent />
        </Box>
      </Router>
    </ThemeProvider>
  );
};

export default App;
